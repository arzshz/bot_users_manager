# telegram | bale — where the daily backup is sent
#   telegram -> api.telegram.org   bale -> tapi.bale.ai
# BOT_TOKEN / BACKUP_CHANNEL_ID must belong to this platform
PLATFORM=telegram

# bot used to upload the DB to the channel (admin of the channel)
BOT_TOKEN=123456:ABC-your-bot-token
BACKUP_CHANNEL_ID=@your_channel_or_-100id

# shared sqlite location; same value must be set in every bot's environment
USERS_DB_PATH=/opt/bot_users_manager/data/users.sqlite

# daily backup time in Tehran (Asia/Tehran), any hour:minute in HH:MM
SEND_TIME=16:00

# optional, seconds between heartbeat logs in main.py (default 3600)
# HEARTBEAT_SECONDS=3600
